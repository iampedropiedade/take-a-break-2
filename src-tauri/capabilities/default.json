{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "overlay*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "notification:default",
    "dialog:default",
    "autostart:default"
  ]
}
